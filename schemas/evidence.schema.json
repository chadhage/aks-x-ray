{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AKS X-Ray evidence bundle",
  "description": "The dependency-free runtime validator additionally validates scope, catalogue digest, per-source list shapes and active measurement semantics.",
  "type": "object",
  "required": ["schemaVersion", "toolVersion", "catalogVersion", "catalogDigest", "collectedAt", "synthetic", "target", "scope", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "toolVersion": { "type": "string" },
    "catalogVersion": { "type": "string" },
    "catalogDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "synthetic": { "type": "boolean" },
    "target": {
      "type": "object",
      "required": ["platform", "context", "subscription", "resourceGroup", "cluster"],
      "properties": {
        "platform": { "enum": ["cloud", "local"] },
        "context": { "type": "string", "minLength": 1 },
        "subscription": { "type": "string" },
        "tenant": { "type": "string", "format": "uuid" },
        "resourceGroup": { "type": "string" },
        "cluster": { "type": "string" },
        "binding": { "type": "object" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["categories", "namespaces", "excludedNamespaces", "profile"],
      "properties": {
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "namespaces": { "type": ["array", "null"], "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "excludedNamespaces": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "profile": { "enum": ["production", "development"] },
        "strategies": { "type": "array", "minItems": 1, "uniqueItems": true, "contains": { "const": "azure" },
          "items": { "enum": ["azure", "kubernetes", "iam", "policy", "defender", "advisor", "dependencies", "resource-graph", "iam-inventory"] } },
        "authorization": { "type": "object", "required": ["readOnly"], "properties": { "readOnly": { "const": true } }, "additionalProperties": false },
        "authorizedSubscriptions": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
        "relatedResourceIds": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "pattern": "^/subscriptions/" } },
        "maxRelatedResources": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "assessmentStrategies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["configuration", "graph", "exposure", "attack-paths", "validation"] } },
        "maxInventoryResources": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "scenario": {
          "type": "object",
          "required": ["name", "profile", "apiAccess", "minimumReplicas", "minimumZones", "allowedRegistries"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "profile": { "enum": ["production", "development"] },
            "apiAccess": { "enum": ["private", "restricted-public", "either"] },
            "minimumReplicas": { "type": "integer", "minimum": 1, "maximum": 100 },
            "minimumZones": { "type": "integer", "minimum": 1, "maximum": 3 },
            "allowedRegistries": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "businessCriticality": { "enum": ["low", "medium", "high", "critical"] },
            "dataSensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
            "applicationExposure": { "enum": ["private", "public", "mixed"] },
            "assumedCompromise": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": { "strategies": ["authorization", "authorizedSubscriptions", "relatedResourceIds", "maxRelatedResources"] },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "propertyNames": { "enum": [
        "context", "cluster", "nodepools", "diagnostics", "maintenance", "nodes", "namespaces",
        "deployments", "statefulsets", "daemonsets", "jobs", "cronjobs", "pods", "services",
        "endpointslices", "ingresses", "networkpolicies", "pdbs", "pvcs", "pvs", "storageclasses",
        "hpas", "serviceaccounts", "resourcequotas", "limitranges", "events", "clusterrolebindings",
        "roles", "rolebindings", "clusterroles", "validatingwebhooks", "mutatingwebhooks",
        "accounts", "roleAssignments", "policyStates", "defenderPricing", "defenderAssessments", "advisorRecommendations", "relatedResources",
        "roleDefinitions", "federatedCredentials", "resourceGraph",
        "activeConnectivity", "activeE2E", "activeLoad", "activeSecurity"
      ] },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "activeRun": { "type": "object" }
  },
  "$defs": {
    "resourceFailure": {
      "type": "object", "required": ["resourceId", "error"],
      "properties": {
        "resourceId": { "type": "string" },
        "error": { "$ref": "#/$defs/source/properties/error" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["status", "collectedAt"],
      "properties": {
        "status": { "enum": ["ok", "error", "notCollected", "notApplicable"] },
        "collectedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "data": { "type": "object" },
        "error": { "type": "object", "required": ["code", "message"], "properties": {
          "code": { "type": "string" }, "message": { "type": "string" }, "exitCode": { "type": ["integer", "null"] }
        } },
        "reason": { "type": "string" },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/resourceFailure" } },
        "namespace": { "type": "string" },
        "runId": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "ok" } } }, "then": { "properties": { "data": { "type": "object" } }, "required": ["data"] } },
        { "if": { "properties": { "status": { "const": "error" } } }, "then": { "properties": { "error": { "type": "object" } }, "required": ["error"] } }
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object", "required": ["file", "args"],
      "properties": {
        "file": { "type": "string" }, "args": { "type": "array", "items": { "type": "string" } },
        "format": { "enum": ["text"] },
        "scopeResourceId": { "type": "string" },
        "identityResourceId": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
